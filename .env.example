# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis na Vercel.
# Sem DATABASE_URL e sem AUTH_GOOGLE_ID, o site roda em modo demonstração (banco local + login sem conta).

# Connection string do Neon (Dashboard do projeto > Connect). Use a versão "pooled".
DATABASE_URL=

# Auth.js: gere com `npx auth secret` (ou qualquer texto aleatório longo).
AUTH_SECRET=

# Google OAuth (console.cloud.google.com > APIs e serviços > Credenciais > ID do cliente OAuth).
# URI de redirecionamento autorizado: https://SEU-DOMINIO/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# E-mails Google que podem entrar no painel, separados por vírgula.
ADMIN_EMAILS=dono@gmail.com

# Só para DEMONSTRAÇÃO: libera o botão "Entrar (demonstração)" no painel, sem senha.
# Nunca use num site em produção de verdade.
# DEMO_LOGIN=true
